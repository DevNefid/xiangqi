{
    "version": 2,
    "builds": [
        {
            "src": "client/pages/index.html",
            "use": "@vercel/static"
        },
        {
            "src": "client/pages/404.html",
            "use": "@vercel/static"
        },
        {
            "src": "client/pages/auto/**",
            "use": "@vercel/static"
        },
        {
            "src": "server/server.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/",
            "dest": "client/pages/index.html"
        },
        {
            "src": "/(.*)",
            "dest": "client/pages/auto/$1.html"
        },
        {
            "handle": "miss",
            "src": "/(.*)",
            "dest": "client/pages/404.html",
            "status": 404
        }
    ]
}