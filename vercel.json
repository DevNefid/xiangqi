{
    "version": 2,
    "builds": [
        {
            "src": "client/public/index.html", 
            "use": "@vercel/static"
        },
        {
            "src": "client/client.js", 
            "use": "@vercel/static"
        },
        {
            "src": "server/server.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/",
            "dest": "client/pages/index.html"
        },
        {
            "src": "/(.*)",
            "dest": "client/pages/$1/index.html"
        },
        {
            "src": "/(.*)",
            "dest": "client/pages/404/index.html",
            "status": 404
        }
    ]
}