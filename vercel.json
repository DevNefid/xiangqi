{
    "version": 2,
    "builds": [
        {
            "src": "client/public/index.html", 
            "use": "@vercel/static"
        },
        {
            "src": "server/server.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "client/$1"
        },
        {
            "src": "/(.*)",
            "dest": "server/server.js"
        }
    ]
}